{
  "name": "@blinch/backend",
  "version": "1.0.0",
  "description": "Express backend for Blinch BCH-Action JSON API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
