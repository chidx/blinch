{
  "name": "@blinch/backend",
  "version": "1.0.0",
  "description": "Express backend for Blinch BCH-Action JSON API with MCP Gateway",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --import tsx/esm src/server.ts",
    "build": "tsup src/server.ts --format esm --clean",
    "build:mcp": "tsup src/mcp/index.ts --format esm --outDir dist/mcp --clean",
    "start": "node dist/server.js",
    "start:mcp": "node dist/mcp/index.js",
    "test": "jest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "mcp": "node --import tsx/esm src/mcp/index.ts"
  },
  "keywords": [
    "express",
    "bitcoin-cash",
    "api",
    "mcp",
    "ai-gateway"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "cashscript": "^0.12.1",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "helmet": "^8.0.0",
    "nanoid": "^5.1.6"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}