# Blinch Contract Deployment Environment Variables

# Network Configuration
NETWORK=chipnet

# HD Wallet Configuration (recommended)
MNEMONIC="your twelve word mnemonic phrase goes here"
DERIVATION_PATH="m/44'/145'/0'/0/0"

# OR use direct keys (not recommended for production)
CREATOR_PUBLIC_KEY="02abc...def"
CREATOR_PRIVATE_KEY="your_private_key_here"

# Recipient Configuration
RECIPIENT_PUBLIC_KEY="03xyz...abc"

# Deployment Options
TIMEOUT_BLOCKS=144
